### PR Checks

< ./gh.impersonate.http.js

# @graphql
# @operation PRChecks
# @name PR Checks
# @tag PR

GRAPHQL {{GRAPHQL_URL}} HTTP/1.1
Accept: application/json

query FetchCheckRuns($cursor: String!, $url: URI!) {
  rateLimit {
    cost
    limit
    nodeCount
    remaining
    resetAt
    used
  }
  resource(url: $url) {
    ... on PullRequest {
      title
      number
      url
      repository {
        nameWithOwner
      }
      merged
      isDraft
      closed
      headRefName
      commits(last: 1) {
        nodes {
          commit {
            statusCheckRollup {
              state
              contexts(first: 100, after: $cursor) {
                totalCount
                checkRunCount
                checkRunCountsByState {
                  count
                  state
                }
                statusContextCount
                statusContextCountsByState {
                  count
                  state
                }
                nodes {
                  __typename
                  ... on CheckRun {
                    id
                    name
                    status
                    title
                    url
                    detailsUrl
                    conclusion
                    databaseId
                    startedAt
                    completedAt
                    checkSuite {
                      conclusion
                      status
                      databaseId
                      branch {
                        name
                      }
                      app {
                        id
                        name
                      }
                      workflowRun {
                        id
                        url
                        databaseId
                        event
                        runNumber
                        runAttempt
                        pendingDeploymentRequests(first: 1) {
                          nodes {
                            environment {
                              name
                            }
                          }
                        }
                        workflow {
                          id
                          name
                          databaseId
                        }
                      }
                    }
                  }
                  ... on StatusContext {
                    context
                    description
                    state
                  }
                }
                pageInfo {
                  endCursor
                  hasNextPage
                  hasPreviousPage
                }
              }
            }
          }
        }
      }
    }
  }
}

{ "cursor": "MTAw", "url": "https://github.com/port-labs/Port/pull/18518" }

### Repo Checks

# @graphql
# @operation RepoChecks
# @name Repo Checks
# @tag Repo

POST {{graphql.endpoint}} HTTP/1.1
Accept: application/json

query RepoChecks($url: URI!){
  resource(url: $url) {
    ... on PullRequest {
      lastCommit: commits(last: 1) {
        nodes {
          commit {
            statusCheckRollup {
              state
            }
          }
        }
      }
      allCommits: commits(last: 100) {
        nodes {
          commit {
            abbreviatedOid
            committedDate
            messageHeadline
            author {
              name
              user {
                login
              }
            }
            statusCheckRollup {
              state
              contexts(last: 1) {
                checkRunCount
                checkRunCountsByState {
                  count
                  state
                }
              }
            }
            checkSuites {
              totalCount
            }
          }
        }
      }
    }
  }
}

### Repo Checks (REST)

# @name Repo Checks (REST)
# @tag PR

GET {{rest.endpoint}}/repos/block/buzz/actions/runs HTTP/1.1
Accept: application/json
